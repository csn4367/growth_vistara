      <details class="more"><summary>Need more than one service?</summary><div class="checks"><label><input type="checkbox" name="more" value="Logo & Branding"> Logo & Branding</label><label><input type="checkbox" name="more" value="Graphic Design"> Graphic Design</label><label><input type="checkbox" name="more" value="Animation"> Animation</label><label><input type="checkbox" name="more" value="Explainer Video"> Explainer Video</label><label><input type="checkbox" name="more" value="Website Design & Development"> Website Design & Development</label><label><input type="checkbox" name="more" value="SEO"> SEO</label><label><input type="checkbox" name="more" value="SEM"> SEM</label><label><input type="checkbox" name="more" value="SMM"> SMM</label><label><input type="checkbox" name="more" value="Paid Campaigns"> Paid Campaigns</label><label><input type="checkbox" name="more" value="Lead Generation"> Lead Generation</label><label><input type="checkbox" name="more" value="Bulk SMS Service"> Bulk SMS Service</label><label><input type="checkbox" name="more" value="Email Marketing"> Email Marketing</label><label><input type="checkbox" name="more" value="WhatsApp Marketing"> WhatsApp Marketing</label></div></details></div>
    <div class="full"><label for="f-req">Project requirements <span class="req">*</span></label><textarea id="f-req" name="requirements" aria-describedby="e-requirements" required></textarea><p class="err" id="e-requirements"></p></div>
    <div><label for="f-web">Website URL (optional)</label><input id="f-web" name="website" inputmode="url" autocomplete="url" aria-describedby="e-website"><p class="err" id="e-website"></p></div>
    <div><label for="f-budget">Approximate budget (optional)</label><select id="f-budget" name="budget"><option value="">Prefer not to say</option><option>Under ₹50,000</option><option>₹50,000 – ₹2,00,000</option><option>₹2,00,000 – ₹5,00,000</option><option>Above ₹5,00,000</option><option>Not sure yet</option></select></div>
    <div><label for="f-time">Expected timeline (optional)</label><select id="f-time" name="timeline"><option value="">Not sure yet</option><option>Within 1 month</option><option>1 – 3 months</option><option>3+ months</option><option>Flexible</option></select></div>
    <fieldset><legend>Preferred contact method</legend><div class="radios">
      <label><input type="radio" name="contactMethod" value="Email" checked><span>Email</span></label><label><input type="radio" name="contactMethod" value="Phone"><span>Phone</span></label><label><input type="radio" name="contactMethod" value="WhatsApp"><span>WhatsApp</span></label></div></fieldset>
    <div class="hp" aria-hidden="true"><label>Leave empty<input name="hp" tabindex="-1" autocomplete="off"></label></div>
    <div class="full"><label class="agree"><input type="checkbox" name="consent" aria-describedby="e-consent"><span>I agree that Growth Vistara may contact me about this enquiry. <span class="req">*</span></span></label><p class="err" id="e-consent"></p></div>
    <div class="full"><button class="btn blue" type="submit" style="width:100%">Send My Enquiry <svg class="ic"><use href="#i-send"/></svg></button></div>
    <p class="note full">We use these details only to respond to your enquiry. See the Privacy Policy in the footer.</p>
  </form>
</dialog>

<script>
/* ============ SETTINGS: edit these before going live ============ */
var CONFIG = {
  // Paste your form service URL here (Formspree, Web3Forms, Getform or your own API).
  //   Formspree:  https://formspree.io/f/yourFormId
  //   Web3Forms:  https://api.web3forms.com/submit   (also set FORM_ACCESS_KEY below)
  FORM_ENDPOINT: '',
  FORM_ACCESS_KEY: ''
};
/* ================================================================= */
(function () {
  'use strict';
  var $ = function (s, c) { return (c || document).querySelector(s); };
  var $$ = function (s, c) { return Array.prototype.slice.call((c || document).querySelectorAll(s)); };
  var root = document.documentElement;
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Menu sheet */
  var sheet = $('#sheet'), burger = $('#burger');
  function menu(open) {
    sheet.classList.toggle('open', open); sheet.setAttribute('aria-hidden', !open);
    burger.setAttribute('aria-expanded', open); root.classList.toggle('lock', open);
  }
  burger.addEventListener('click', function () { menu(true); });
  $('#close-menu').addEventListener('click', function () { menu(false); });
  $$('#sheet nav a').forEach(function (a) { a.addEventListener('click', function () { menu(false); }); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && sheet.classList.contains('open')) menu(false); });

  /* Reveal on scroll */
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); }, { threshold: .15 });
    $$('.rv').forEach(function (el) { io.observe(el); });
  } else $$('.rv').forEach(function (el) { el.classList.add('in'); });

  /* Scroll-linked progress (no scroll hijacking) */
  var prog = $$('[data-progress]'), art = $('.art'), dock = $('#dock'), tick = false;
  function frame() {
    tick = false; var vh = innerHeight, y = scrollY, max = root.scrollHeight - vh;
    root.style.setProperty('--sp', max > 0 ? (y / max).toFixed(4) : 0);
    prog.forEach(function (el) {
      if (reduce) { el.style.setProperty('--p', 1); return; }
      var r = el.getBoundingClientRect(), p = (vh * .85 - r.top) / (Math.min(r.height, vh) * .8);
      el.style.setProperty('--p', Math.max(0, Math.min(1, p)).toFixed(3));
    });
    if (art && !reduce) art.style.setProperty('--hp', Math.min(1, y / (vh * .7)).toFixed(3));
    dock.classList.toggle('show', y > vh * .55 && !$('#enquiry').open);
  }
  function onScroll() { if (!tick) { tick = true; requestAnimationFrame(frame); } }
  addEventListener('scroll', onScroll, { passive: true }); addEventListener('resize', onScroll); frame();

  /* Fun: logo spin, cursor dot (desktop only) */
  var brand = $('.nav .brand'); brand.addEventListener('click', function () { brand.classList.add('spin'); setTimeout(function () { brand.classList.remove('spin'); }, 700); });
  if (matchMedia('(pointer:fine)').matches && !reduce) {
    var cur = $('.cur'), x = 0, y = 0, cx = 0, cy = 0;
    addEventListener('mousemove', function (e) { x = e.clientX; y = e.clientY; cur.classList.add('on'); });
    (function loop() { cx += (x - cx) * .2; cy += (y - cy) * .2; cur.style.transform = 'translate(' + (cx - 9) + 'px,' + (cy - 9) + 'px)'; requestAnimationFrame(loop); })();
    document.addEventListener('mouseover', function (e) { cur.classList.toggle('big', !!e.target.closest('a,button,.card,.chip,.pc')); });
  }

  /* Enquiry modal */
  var dlg = $('#enquiry'), form = $('#form'), banner = $('#banner'), done = $('#done'), opener = null;
  function open(service, trigger) {
    opener = trigger || document.activeElement;
    if (service) $('#f-service').value = service;
    done.hidden = true; form.hidden = false; banner.textContent = ''; banner.className = 'banner full';
    menu(false); dlg.showModal(); root.classList.add('lock'); dock.classList.remove('show');
    setTimeout(function () { $('#f-name').focus({ preventScroll: true }); }, 80);
  }
  dlg.addEventListener('close', function () { root.classList.remove('lock'); if (opener && opener.focus) opener.focus(); onScroll(); });
  dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
  $('.x', dlg).addEventListener('click', function () { dlg.close(); });
  $('#done-close').addEventListener('click', function () { dlg.close(); });
  document.addEventListener('click', function (e) {
    var t = e.target.closest('[data-open]'); if (!t) return; e.preventDefault(); open(t.getAttribute('data-service') || '', t);
  });

  /* Validation */
  var rules = {
    name: function (v) { return v.trim().length > 1 ? '' : 'Enter your full name.'; },
    email: function (v) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()) ? '' : 'Enter a valid business email, like name@company.com.'; },
    company: function (v) { return v.trim() ? '' : 'Enter your company or brand name.'; },
    phone: function (v) { return !v.trim() || /^[0-9 ()\-]{6,16}$/.test(v.trim()) ? '' : 'Use digits only, 6 to 16 characters.'; },
    service: function (v) { return v ? '' : 'Choose the service you need.'; },
    requirements: function (v) { return v.trim().length > 9 ? '' : 'Tell us a little more (at least 10 characters).'; },
    website: function (v) { return !v.trim() || /^(https?:\/\/)?[^\s.]+\.[^\s]{2,}$/.test(v.trim()) ? '' : 'Enter a valid website address.'; },
    consent: function (_, el) { return el.checked ? '' : 'Please confirm so we can reply to your enquiry.'; }
  };
  function err(n, m) { var el = form.elements[n]; $('#e-' + n).textContent = m; m ? el.setAttribute('aria-invalid', 'true') : el.removeAttribute('aria-invalid'); }
  Object.keys(rules).forEach(function (n) { var el = form.elements[n]; el.addEventListener('blur', function () { if (el.value || el.getAttribute('aria-invalid')) err(n, rules[n](el.value, el)); }); });

  function confetti() {
    if (reduce) return; var cols = ['#186DFE', '#000', '#DCE8FF', '#186DFE'];
    for (var i = 0; i < 36; i++) {
      var c = document.createElement('i'); c.className = 'cf'; c.style.background = cols[i % 4]; if (i % 3 === 0) c.style.borderRadius = '50%';
      c.style.setProperty('--cx', (Math.random() * 460 - 230) + 'px'); c.style.setProperty('--cy', (Math.random() * 340 - 120) + 'px'); c.style.setProperty('--cr', (Math.random() * 720 - 360) + 'deg');
      done.appendChild(c); setTimeout(function (n) { n.remove(); }.bind(null, c), 1500);
    }
  }

  /* Submit: inputs are kept on failure; success shows only after the service accepts it */
  form.addEventListener('submit', function (e) {
    e.preventDefault(); banner.textContent = ''; banner.className = 'banner full';
    var first = null;
    Object.keys(rules).forEach(function (n) { var el = form.elements[n], m = rules[n](el.value, el); err(n, m); if (m && !first) first = el; });
    if (first) { first.focus(); return; }
    var f = form.elements, btn = $('button[type=submit]', form), label = btn.innerHTML;
    if (f.hp.value) { return; }                                   /* bot caught by honeypot */
    if (!CONFIG.FORM_ENDPOINT) {
      banner.className = 'banner full bad';
      banner.textContent = 'Development mode: the enquiry form is not connected yet, so this enquiry was NOT sent. Add a form service URL in CONFIG at the bottom of this file.';
      return;
    }
    var more = $$('input[name=more]:checked', form).map(function (i) { return i.value; });
    var data = {
      subject: 'New enquiry: ' + f.service.value + ' (' + f.company.value.trim() + ')',
      name: f.name.value.trim(), email: f.email.value.trim(), company: f.company.value.trim(),
      phone: f.phone.value.trim() ? f.code.value + ' ' + f.phone.value.trim() : '',
      service: f.service.value, other_services: more.join(', '), requirements: f.requirements.value.trim(),
      website: f.website.value.trim(), budget: f.budget.value, timeline: f.timeline.value,
      preferred_contact: $('input[name=contactMethod]:checked', form).value,
      consent: 'Yes, agreed on ' + new Date().toISOString(), page: location.href
    };
    if (CONFIG.FORM_ACCESS_KEY) data.access_key = CONFIG.FORM_ACCESS_KEY;
    btn.disabled = true; btn.textContent = 'Sending…';
    fetch(CONFIG.FORM_ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(data) })
      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (b) { if (!r.ok || b.success === false || b.error) throw new Error(); }); })
      .then(function () { form.hidden = true; done.hidden = false; form.reset(); $('#done-title').focus({ preventScroll: true }); confetti(); })
      .catch(function () { banner.className = 'banner full bad'; banner.setAttribute('role', 'alert'); banner.textContent = 'Your enquiry was not sent. Please check your connection and try again. Your details are still here.'; })
      .then(function () { btn.disabled = false; btn.innerHTML = label; });
  });
})();
</script>
</body>
</html>
