<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Growth Vistara | Growth with direction.</title>
<meta name="description" content="Growth Vistara connects creative thinking with digital execution: branding, websites, performance marketing and customer communication working as one system.">
<meta property="og:title" content="Growth Vistara | Growth with direction.">
<meta property="og:description" content="Clear ideas. Meaningful growth.">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary">
<meta name="theme-color" content="#ffffff">
<link rel="icon" href="data:image/png;base64," type="image/png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Sora:wght@300;600;700;800&display=swap" rel="stylesheet">
<script>document.documentElement.classList.add('js')</script>
<style>
/* ===== Growth Vistara · Brand Book v1.0 tokens (solid colours only) ===== */
:root{
  --blue:#186DFE; --ink:#000; --white:#fff; --mist:#F2F5FA; --sky:#DCE8FF; --slate:#5A6270; --line:#D9DEE8;
  --display:'Sora',system-ui,sans-serif; --body:'Manrope',system-ui,sans-serif;
  --pad:clamp(20px,5vw,56px); --max:1240px; --r:24px; --nav:64px;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth;scroll-padding-top:calc(var(--nav) + 12px);overflow-x:clip}
body{margin:0;font:400 17px/1.6 var(--body);color:var(--ink);background:var(--white);-webkit-font-smoothing:antialiased;overflow-x:clip}
img,svg{display:block;max-width:100%} a{color:inherit} button{font:inherit}
h1,h2,h3,h4,p{margin:0} h1,h2,h3,h4{font-family:var(--display);letter-spacing:-.03em}
:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
.ic{width:1em;height:1em;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}
.wrap{max-width:var(--max);margin:0 auto;padding:0 var(--pad)}
.sec{padding:clamp(72px,12vw,150px) 0}
.dark{background:var(--ink);color:var(--white)} .mist{background:var(--mist)}
.skip{position:absolute;left:-999px;top:8px;background:var(--blue);color:#fff;padding:10px 16px;z-index:200;border-radius:99px}.skip:focus{left:8px}
.bar{position:fixed;inset:0 0 auto 0;height:4px;background:var(--blue);transform:scaleX(var(--sp,0));transform-origin:0 50%;z-index:120}

/* type helpers */
.tag{display:inline-flex;align-items:center;gap:8px;font:700 13px var(--body);color:var(--blue);background:var(--sky);padding:7px 14px;border-radius:99px;margin-bottom:22px}
.dark .tag{background:#0B1F44;color:#9CC0FF}
.h2{font:800 clamp(34px,8.4vw,80px)/1 var(--display);letter-spacing:-.04em;max-width:15ch}
.lead{font-size:clamp(17px,2.3vw,20px);color:var(--slate);max-width:52ch}.dark .lead{color:#C5CCD8}
.out{color:transparent;-webkit-text-stroke:2px currentColor}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:12px 26px;border-radius:99px;font:700 16px var(--body);text-decoration:none;cursor:pointer;border:2px solid var(--ink);background:var(--ink);color:#fff;transition:transform .2s cubic-bezier(.3,1.6,.5,1),background .2s,color .2s,border-color .2s}
.btn:hover{transform:translateY(-3px) rotate(-1deg)} .btn:active{transform:scale(.97)}
.btn.blue{background:var(--blue);border-color:var(--blue)} .btn.blue:hover{background:#fff;color:var(--blue)}
.btn.ghost{background:transparent;color:inherit;border-color:currentColor}.btn.ghost:hover{background:var(--ink);color:#fff;border-color:var(--ink)}
.dark .btn.ghost:hover{background:#fff;color:#000;border-color:#fff}
.btn .ic{width:20px;height:20px;transition:transform .25s}.btn:hover .ic{transform:translate(3px,-3px)}

/* nav */
.nav{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.94);border-bottom:2px solid var(--ink)}
.nav .wrap{height:var(--nav);display:flex;align-items:center;justify-content:space-between;gap:12px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;font:800 17px var(--display);letter-spacing:-.02em}
.sym{background:var(--sym) center/contain no-repeat;display:block}
.brand .sym{width:44px;height:26px;background-color:var(--ink);border-radius:8px;background-size:78%;transition:transform .6s cubic-bezier(.3,1.6,.5,1)}
.brand.spin .sym{transform:rotate(360deg) scale(1.15)}
.brand small{font:300 11px var(--display);letter-spacing:.34em;color:var(--blue);margin-left:.4em}
.links{display:none;align-items:center;gap:6px}
.links a:not(.btn){padding:10px 16px;border-radius:99px;font-weight:600;font-size:15px;text-decoration:none;transition:background .2s}
.links a:not(.btn):hover{background:var(--mist)}.links .btn{min-height:44px;padding:8px 22px;font-size:15px}
.burger{width:48px;height:48px;border-radius:50%;border:2px solid var(--ink);background:#fff;display:grid;place-items:center;cursor:pointer;font-size:22px}
@media(min-width:900px){.links{display:flex}.burger{display:none}}
.sheet{position:fixed;inset:0;z-index:150;background:var(--ink);color:#fff;display:flex;flex-direction:column;padding:20px var(--pad) 32px;transform:translateY(-100%);visibility:hidden;transition:transform .45s cubic-bezier(.7,0,.2,1),visibility 0s .45s}
.sheet.open{transform:none;visibility:visible;transition:transform .45s cubic-bezier(.7,0,.2,1)}
.sheet header{display:flex;justify-content:space-between;align-items:center;height:48px}
.sheet .burger{background:transparent;color:#fff;border-color:#fff}
.sheet nav{display:grid;gap:4px;margin:auto 0}
.sheet nav a{font:800 clamp(40px,12vw,64px)/1.15 var(--display);letter-spacing:-.04em;text-decoration:none;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #222;padding:6px 0}
.sheet nav a:active{color:var(--blue)} .sheet nav a .ic{font-size:.5em;color:var(--blue)}

/* hero */
.hero{padding:clamp(32px,6vw,72px) 0 0;position:relative;overflow:clip}
.hero .wrap{display:grid;gap:12px;align-items:center}
.hero .tag{margin-bottom:20px}
.hero h1{font:800 clamp(46px,13.2vw,132px)/.95 var(--display);letter-spacing:-.05em}
.hero h1 .w{display:inline-block;overflow:clip;vertical-align:top;padding:.06em .14em .12em;margin:0 -.14em}
.hero h1 .w>span{display:inline-block}
.js .hero h1 .w>span{transform:translateY(110%);animation:up .8s cubic-bezier(.2,.8,.2,1) forwards;animation-delay:calc(var(--i)*.07s + .1s)}
.hero h1 .hl{display:inline-block;background:var(--blue);color:#fff;padding:0 .18em .06em;border-radius:.22em;transform:rotate(-3deg);margin:0 .04em;animation:wob 4.5s ease-in-out 1.2s infinite}
.hero .lead{margin:24px 0 30px}
.ctas{display:flex;flex-wrap:wrap;gap:12px}.ctas .btn{flex:1 1 220px}
.art{position:relative;width:min(100%,420px);aspect-ratio:1;margin:14px auto 0;--hp:0}
.art svg.arrow{width:100%;height:100%;overflow:visible}
.art .go{transform:translate(calc(var(--hp)*60px),calc(var(--hp)*-60px))}
.art .shaft{stroke-dasharray:1;stroke-dashoffset:1;animation:draw 1s .5s cubic-bezier(.6,0,.2,1) forwards}
.art .head{transform-box:fill-box;transform-origin:100% 0;transform:scale(0);animation:pop .6s 1.35s cubic-bezier(.3,1.8,.5,1) forwards;}
.art .dot{transform-box:fill-box;transform-origin:center;animation:pulse 2s ease-in-out infinite}
.badge{position:absolute;left:-2%;bottom:2%;width:34%;aspect-ratio:1;animation:spin 18s linear infinite}
.badge svg{width:100%;height:100%} .badge text{font:700 11.4px var(--display);letter-spacing:.14em;fill:#fff}
.badge .c{position:absolute;inset:0;display:grid;place-items:center}
.chip{position:absolute;display:inline-flex;align-items:center;gap:8px;background:#fff;border:2px solid var(--ink);border-radius:99px;padding:8px 16px 8px 10px;font:700 14px var(--body);animation:bob 4s ease-in-out infinite;animation-delay:var(--d,0s);white-space:nowrap}
.chip i{width:28px;height:28px;border-radius:50%;background:var(--blue);color:#fff;display:grid;place-items:center;font-size:16px}
.chip.a{top:6%;left:0;--d:-1s}.chip.b{top:44%;right:-2%;--d:-2s}.chip.c2{bottom:8%;right:12%;--d:-3s;display:none}
.js .hero .rise{opacity:0;animation:fade .8s .5s forwards}
@media(min-width:900px){.hero h1{font-size:clamp(60px,7vw,108px)}.hero .wrap{grid-template-columns:1.3fr 1fr;gap:32px}.art{margin:0 0 0 auto;width:100%}.chip.c2{display:inline-flex}}
.marq{margin-top:clamp(40px,7vw,80px);background:var(--ink);color:#fff;overflow:hidden;border-block:2px solid var(--ink)}
.marq div{display:flex;width:max-content;animation:marq 38s linear infinite}
.marq:hover div{animation-play-state:paused}
.marq span{display:inline-flex;align-items:center;gap:20px;padding:16px 10px 16px 0;font:700 clamp(18px,3vw,26px) var(--display);letter-spacing:-.02em;white-space:nowrap}
.marq span .ic{color:var(--blue);width:22px;height:22px}

/* problem */
.problem{--p:1}
.problem .grid{display:grid;gap:44px}
.close{font:300 clamp(26px,5vw,44px)/1.15 var(--display);letter-spacing:-.03em;margin-top:36px;max-width:18ch}
.close b{font-weight:800;color:var(--blue)}
.scatter{position:relative;min-height:380px;overflow:hidden;padding-left:18px}
.scatter:before{content:"";position:absolute;left:6px;top:0;bottom:0;width:4px;background:var(--ink);border-radius:4px;transform:scaleY(var(--p));transform-origin:top}
.pc{position:absolute;left:18px;top:calc(var(--i)*19% + 1%);display:inline-flex;align-items:center;gap:10px;font:700 clamp(18px,4.6vw,26px) var(--display);background:#fff;border:2px solid var(--ink);border-radius:99px;padding:9px 22px 9px 10px;letter-spacing:-.02em;
  transform:translate(calc((1 - var(--p))*var(--x)),calc((1 - var(--p))*var(--y))) rotate(calc((1 - var(--p))*var(--r)))}
.pc i{width:34px;height:34px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;font-size:18px}
.pc.on{background:var(--blue);border-color:var(--blue);color:#fff}.pc.on i{background:#fff;color:var(--blue)}
@media(min-width:900px){.problem .grid{grid-template-columns:1fr 1fr;align-items:center;gap:80px}.scatter{min-height:440px}}

/* system */
.system{--p:1}
.sys{position:relative;display:grid;gap:16px;margin-top:48px}
.hub{width:132px;height:132px;margin:0 auto 8px;border-radius:50%;background:var(--blue);display:grid;place-items:center;position:relative;transform:scale(calc(.6 + .4*var(--p)))}
.hub:after{content:"";position:absolute;inset:-12px;border:2px dashed #3C79E8;border-radius:50%;animation:spin 20s linear infinite}
.hub .sym{width:78%;height:60%;background-image:var(--symw)}
.pill{background:#0D0D0D;border:2px solid #222;border-radius:var(--r);padding:24px;display:grid;gap:10px;transition:border-color .2s,transform .25s cubic-bezier(.3,1.6,.5,1);transform:translateY(calc((1 - var(--p))*30px));opacity:calc(.3 + .7*var(--p))}
.pill:hover{border-color:var(--blue);transform:translateY(-4px) rotate(-.6deg)}
.pill i{width:48px;height:48px;border-radius:50%;background:var(--blue);display:grid;place-items:center;font-size:24px}
.pill small{font:700 13px var(--body);color:#9CC0FF}.pill h3{font:800 28px var(--display)}.pill p{color:#C5CCD8;font-size:16px}
@media(min-width:760px){.sys{grid-template-columns:1fr 1fr;gap:20px 150px}.hub{position:absolute;left:50%;top:50%;margin:0;transform:translate(-50%,-50%) scale(calc(.6 + .4*var(--p)));width:170px;height:170px;z-index:2}}

/* services */
.tabs{position:sticky;top:var(--nav);z-index:60;background:rgba(255,255,255,.96);margin:40px calc(var(--pad)*-1) 0;padding:12px var(--pad);display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;border-bottom:1px solid var(--line)}
.tabs::-webkit-scrollbar{display:none}
.tabs a{flex:none;display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border-radius:99px;border:2px solid var(--ink);font:700 14px var(--body);text-decoration:none;background:#fff;transition:background .2s,color .2s}
.tabs a:hover,.tabs a:active{background:var(--ink);color:#fff}.tabs a .ic{color:var(--blue)}
.cat{padding-top:56px}.cat h3{display:flex;align-items:center;gap:14px;font:800 clamp(24px,6vw,36px) var(--display);margin-bottom:6px}
.cat h3 span{width:44px;height:44px;border-radius:14px;background:var(--blue);color:#fff;display:grid;place-items:center;font-size:24px;transform:rotate(-6deg)}
.cat>p{color:var(--slate);margin:0 0 20px 58px}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,270px),1fr));gap:14px}
.card{position:relative;isolation:isolate;background:transparent;border:0;border-radius:var(--r);padding:24px;display:flex;flex-direction:column;gap:10px;transition:transform .3s cubic-bezier(.3,1.6,.5,1)}
.card:before{content:"";position:absolute;inset:0;background:var(--blue);border-radius:var(--r);z-index:-2;transition:transform .25s}.card:after{content:"";position:absolute;inset:0;background:#fff;border:2px solid var(--ink);border-radius:var(--r);z-index:-1}
.card:hover,.card:focus-within{transform:translate(-5px,-5px)}.card:hover:before,.card:focus-within:before{transform:translate(5px,5px)}
.card:active{transform:scale(.98)}
.card .i{width:56px;height:56px;border-radius:50%;background:var(--sky);color:var(--blue);display:grid;place-items:center;font-size:28px;transition:transform .4s cubic-bezier(.3,1.8,.5,1),background .2s,color .2s}
.card:hover .i{transform:rotate(-12deg) scale(1.12);background:var(--blue);color:#fff}
.card h4{font:700 21px/1.2 var(--display);letter-spacing:-.02em}.card p{color:var(--slate);font-size:16px;flex:1}
.card .go{align-self:flex-start;display:inline-flex;align-items:center;gap:6px;margin-top:6px;min-height:44px;padding:8px 18px;border-radius:99px;border:2px solid var(--ink);background:#fff;font:700 14px var(--body);cursor:pointer;transition:background .2s,color .2s}
.card .go:hover{background:var(--ink);color:#fff}.card .go .ic{width:16px;height:16px}
.cats{isolation:isolate}

/* process */
.steps{list-style:none;margin:56px 0 0;padding:0 0 0 30px;display:grid;gap:34px;position:relative;--p:1}
.steps:before{content:"";position:absolute;left:9px;top:8px;bottom:8px;width:4px;background:var(--line);border-radius:4px}
.steps:after{content:"";position:absolute;left:9px;top:8px;bottom:8px;width:4px;background:var(--blue);border-radius:4px;transform:scaleY(var(--p));transform-origin:top}
.steps li{position:relative}.steps li:before{content:"";position:absolute;left:-29px;top:6px;width:22px;height:22px;border-radius:50%;background:#fff;border:4px solid var(--blue)}
.steps b{font:800 14px var(--display);color:var(--blue)}.steps h3{font:800 30px var(--display);margin:2px 0 6px}.steps p{color:var(--slate);font-size:16px;max-width:30ch}
@media(min-width:900px){.steps{grid-template-columns:repeat(4,1fr);gap:28px;padding:36px 0 0}
 .steps:before,.steps:after{left:0;right:0;top:9px;bottom:auto;height:4px;width:auto}.steps:after{transform:scaleX(var(--p));transform-origin:left}
 .steps li:before{left:0;top:-36px}}

/* work */
.work{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;margin:44px calc(var(--pad)*-1) 0;padding:6px var(--pad) 20px;scrollbar-width:none}.work::-webkit-scrollbar{display:none}
.proj{flex:0 0 min(78vw,320px);scroll-snap-align:start;border:2px solid var(--ink);border-radius:var(--r);background:#fff;overflow:hidden;transition:transform .3s cubic-bezier(.3,1.6,.5,1)}
.proj:hover{transform:translateY(-6px) rotate(-1deg)}
.proj .th{aspect-ratio:4/3;display:grid;place-items:center;background:var(--mist);border-bottom:2px solid var(--ink);color:var(--blue);font-size:44px;text-align:center}
.proj:nth-child(even) .th{background:var(--sky)}
.proj .tx{padding:16px 18px}.proj h4{font:700 19px var(--display)}.proj p{color:var(--slate);font-size:14px;margin-top:2px}
.proj .ph{display:block;font:600 12px var(--body);color:var(--slate);margin-top:4px}
@media(min-width:900px){.work{display:grid;grid-template-columns:repeat(3,1fr);overflow:visible;margin:48px 0 0;padding:0}.proj{flex:none}}

/* about */
.about{display:grid;gap:40px;align-items:center}
.about .big{width:min(100%,380px);aspect-ratio:1;margin:0 auto;border-radius:50%;background:var(--blue);display:grid;place-items:center;position:relative}
.about .big .sym{width:70%;height:50%;background-image:var(--symw)}
.about .big:after{content:"";position:absolute;inset:-14px;border:2px dashed #3C79E8;border-radius:50%;animation:spin 30s linear infinite reverse}
.vals{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}.vals span{padding:10px 18px;border-radius:99px;border:2px solid #fff;font:700 15px var(--body)}
.vals span:nth-child(2){background:var(--blue);border-color:var(--blue);transform:rotate(-2deg)}
@media(min-width:900px){.about{grid-template-columns:1.3fr 1fr;gap:80px}}

/* cta */
.cta{position:relative;overflow:clip;text-align:left}
.cta .h2{font-size:clamp(40px,11vw,112px);max-width:12ch}.cta .lead{margin:24px 0 32px}
.cta svg.arr{position:absolute;right:-6%;bottom:-6%;width:min(62vw,540px);opacity:.28;pointer-events:none}
.cta .wrap{position:relative}
@media(min-width:900px){.cta svg.arr{opacity:1}}
.cta .arr .shaft{stroke-dasharray:1;stroke-dashoffset:calc(1 - var(--p,1))}

/* footer */
footer{background:var(--ink);color:#C5CCD8;padding:56px 0 calc(40px + env(safe-area-inset-bottom));border-top:1px solid #222;font-size:15px}
.fg{display:grid;gap:36px}.fg .logo{width:150px;height:130px;background:var(--logo) left center/contain no-repeat}
footer h5{font:700 13px var(--body);color:#fff;margin:0 0 12px}footer ul{list-style:none;margin:0;padding:0;display:grid;gap:4px}
footer a{display:inline-block;padding:6px 0;text-decoration:none}footer a:hover{color:#fff;text-decoration:underline}
details{border-top:1px solid #222;padding:14px 0}details summary{cursor:pointer;font-weight:700;color:#fff}details p{margin-top:8px}
.legal{margin-top:36px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px;font-size:14px}
@media(min-width:900px){.fg{grid-template-columns:2fr 1fr 1.4fr 1fr}}

/* mobile dock */
.dock{position:fixed;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom));z-index:90;transform:translateY(160%);transition:transform .4s cubic-bezier(.3,1.4,.5,1)}
.dock.show{transform:none}.dock .btn{width:100%;min-height:56px;border-color:#fff;font-size:17px}
@media(min-width:900px){.dock{left:auto;right:24px;bottom:24px;width:auto}.dock .btn{min-height:52px}}
html.lock{overflow:hidden}

/* cursor */
.cur{position:fixed;left:0;top:0;width:18px;height:18px;border-radius:50%;background:var(--blue);pointer-events:none;z-index:300;opacity:0;transition:width .2s,height .2s,opacity .2s,margin .2s;mix-blend-mode:normal}
.cur.on{opacity:.9}.cur.big{width:46px;height:46px;margin:-14px 0 0 -14px;opacity:.35}

/* modal */
dialog{border:0;padding:0;margin:auto auto 0;width:100%;max-width:100%;max-height:94svh;background:#fff;color:#000;border-radius:28px 28px 0 0;overflow:auto;overscroll-behavior:contain;opacity:0;transform:translateY(40px);transition:opacity .3s,transform .4s cubic-bezier(.2,.9,.2,1),overlay .3s allow-discrete,display .3s allow-discrete}
dialog[open]{opacity:1;transform:none}@starting-style{dialog[open]{opacity:0;transform:translateY(60px)}}
dialog::backdrop{background:rgba(0,0,0,.7)}
@media(min-width:700px){dialog{margin:auto;width:min(680px,calc(100vw - 32px));border-radius:28px;max-height:92svh}}
.m-head{background:var(--ink);color:#fff;padding:28px 24px 22px;position:relative;border-radius:28px 28px 0 0}
.m-head:before{content:"";display:block;width:44px;height:5px;border-radius:5px;background:#444;margin:-12px auto 16px}@media(min-width:700px){.m-head:before{display:none}}
.m-head h2{font:800 clamp(26px,6vw,36px)/1.05 var(--display);padding-right:52px}.m-head p{margin-top:10px;color:#C5CCD8;font-size:15px}
.x{position:absolute;top:16px;right:16px;width:46px;height:46px;border-radius:50%;border:2px solid #fff;background:transparent;color:#fff;display:grid;place-items:center;font-size:22px;cursor:pointer}.x:hover{background:#fff;color:#000}
form{padding:24px;display:grid;gap:16px}@media(min-width:700px){form{grid-template-columns:1fr 1fr;padding:28px 32px 32px}.full{grid-column:1/-1}}
label,legend{display:block;font:700 14px var(--body);margin-bottom:6px;padding:0}.req{color:var(--blue)}
input,select,textarea{width:100%;font:400 16px var(--body);padding:12px 16px;border:2px solid var(--ink);background:#fff;color:#000;border-radius:16px;min-height:50px}
textarea{min-height:110px;resize:vertical}input:focus,select:focus,textarea:focus{outline:3px solid var(--sky);border-color:var(--blue)}
[aria-invalid=true]{border-color:#C4161C;background:#FFF5F5}.err{color:#C4161C;font:600 14px var(--body);margin-top:6px}.err:empty{display:none}
.phone{display:grid;grid-template-columns:124px 1fr;gap:8px}fieldset{border:0;margin:0;padding:0}
